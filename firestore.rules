// Reglas de Cloud Firestore para Inklus.
// Cada documento de la colección `documents` tiene un campo `uid` con el
// usuario dueño. Solo ese usuario puede leerlo/escribirlo.
//
// Cómo aplicarlas:
//   Opción A (consola): Firebase console → Firestore Database → pestaña "Reglas"
//     → pegar este contenido → Publicar.
//   Opción B (CLI): firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /documents/{docId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }
  }
}
