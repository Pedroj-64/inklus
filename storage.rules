// Reglas de Firebase Storage para Inklus.
// Las imágenes se guardan en images/<userId>/<archivo>: solo un usuario con
// sesión iniciada puede subir o descargar.
//
// Cómo aplicarlas:
//   Opción A (consola): Firebase console → Storage → pestaña "Reglas"
//     → pegar este contenido → Publicar.
//   Opción B (CLI): firebase deploy --only storage
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{userId}/{file} {
      allow read, write: if request.auth != null;
    }
  }
}
